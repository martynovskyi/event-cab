# --- required ---
DATABASE_URL=postgres://events_svc:CHANGE_ME@postgres:5432/events
# At least 32 characters, e.g. `openssl rand -hex 32`.
ADMIN_TOKEN=
# HMAC key for ip_hash / created_ip_hash, e.g. `openssl rand -hex 32`.
IP_HASH_SALT=

# --- optional (defaults shown) ---
# Comma-separated site domains; empty = relative URLs only.
ALLOWED_HOSTS=
PUBLIC_PORT=3001
ADMIN_PORT=3002
EVENTS_PER_IP_MIN=60
EVENTS_PER_MIN=20
NEW_TOPICS_PER_IP_HOUR=3
MAX_PENDING_TOPICS=100
TOGGLE_TOP_N=20
RUST_LOG=info

# --- docker-compose: names of the existing external networks ---
PG_NETWORK=
CMS_NETWORK=
WEB_NETWORK=

# --- tests (cargo test): a PG server where the user may create databases ---
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/postgres
